{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "votofacil-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-13",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "votofacil",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations",
    },
  ],
  "vars": { "CORS_ORIGINS": "*" },
  "triggers": { "crons": ["0 * * * *"] },
  "observability": { "enabled": true },
}
